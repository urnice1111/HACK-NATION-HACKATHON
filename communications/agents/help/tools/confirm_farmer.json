{
  "type": "webhook",
  "name": "confirm_farmer",
  "description": "Confirms who you're speaking with after the person said so. Returns their numbered plots and which permissions are still to be asked.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://YOUR-PUBLIC-DOMAIN/v1/tools/confirm-farmer",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "ID_OF_SECRET_WITH_Bearer_ELEVENLABS_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "session_id",
        "candidate_number"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "candidate_number": {
          "type": "integer",
          "description": "Number of the person in resolve_farmer's list (1 = the first)"
        }
      }
    }
  }
}
