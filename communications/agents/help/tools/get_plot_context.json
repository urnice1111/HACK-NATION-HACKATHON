{
  "type": "webhook",
  "name": "get_plot_context",
  "description": "Sets the plot the confirmed farmer is talking about and fetches its context. Use only after confirm_farmer.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://YOUR-PUBLIC-DOMAIN/v1/tools/get-plot-context",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "ID_OF_SECRET_WITH_Bearer_ELEVENLABS_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "plot_number": {
          "type": "integer",
          "description": "Number of the plot in confirm_farmer's list. Omit if they only have one"
        }
      }
    }
  }
}
