{
  "type": "webhook",
  "name": "resolve_farmer",
  "description": "Busca quién llama a partir del número del teléfono. Devuelve solo nombres numerados para confirmar con la persona. Llamar al empezar la llamada.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://TU-DOMINIO-PUBLICO/v1/tools/resolve-farmer",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "ID_DEL_SECRETO_CON_Bearer_ELEVENLABS_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "caller_phone": {
          "type": "string",
          "dynamic_variable": "system__caller_id"
        }
      }
    }
  }
}
