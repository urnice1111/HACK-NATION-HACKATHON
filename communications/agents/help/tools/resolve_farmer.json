{
  "type": "webhook",
  "name": "resolve_farmer",
  "description": "Looks up who is calling from the phone number. Returns only numbered names to confirm with the person. Call it at the start of the call.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://YOUR-PUBLIC-DOMAIN/v1/tools/resolve-farmer",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "ID_OF_SECRET_WITH_Bearer_ELEVENLABS_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "caller_phone": {
          "type": "string",
          "dynamic_variable": "system__caller_id"
        }
      }
    }
  }
}
