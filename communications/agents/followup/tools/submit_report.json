{
  "type": "webhook",
  "name": "submit_report",
  "description": "Guarda la observación que el agricultor confirmó, al terminar la evaluación de una parcela que empeoró.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://YOUR-PUBLIC-DOMAIN/v1/tools/submit-report",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "ID_OF_SECRET_WITH_Bearer_ELEVENLABS_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "session_id",
        "user_statement",
        "completeness"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "dynamic_variable": "session_id"
        },
        "plot_id": {
          "type": "string",
          "dynamic_variable": "plot_id"
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "user_statement": {
          "type": "string",
          "description": "Resumen de lo que el agricultor contó, con sus palabras"
        },
        "symptoms": {
          "type": "array",
          "description": "Síntomas concretos mencionados",
          "items": {
            "type": "string",
            "description": "Un síntoma concreto, por ejemplo 'manchas amarillas en hojas'"
          }
        },
        "completeness": {
          "type": "string",
          "description": "sufficient si la evaluación terminó con orientación; partial en otro caso",
          "enum": [
            "partial",
            "sufficient"
          ]
        },
        "assessment_id": {
          "type": "string",
          "description": "assessment_id de la última respuesta de assess_observation"
        }
      }
    }
  }
}
