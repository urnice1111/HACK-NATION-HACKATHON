{
  "type": "webhook",
  "name": "submit_report",
  "description": "Saves the observation the farmer confirmed, when the assessment of a plot that got worse ends.",
  "response_timeout_secs": 10,
  "api_schema": {
    "url": "https://YOUR-PUBLIC-DOMAIN/v1/tools/submit-report",
    "method": "POST",
    "request_headers": {
      "Authorization": {
        "secret_id": "ID_OF_SECRET_WITH_Bearer_ELEVENLABS_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "session_id",
        "user_statement",
        "completeness"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "dynamic_variable": "session_id"
        },
        "plot_id": {
          "type": "string",
          "dynamic_variable": "plot_id"
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "user_statement": {
          "type": "string",
          "description": "Summary of what the farmer said, in their own words"
        },
        "symptoms": {
          "type": "array",
          "description": "Concrete symptoms mentioned",
          "items": {
            "type": "string",
            "description": "One concrete symptom, for example 'yellow spots on leaves'"
          }
        },
        "completeness": {
          "type": "string",
          "description": "sufficient if the assessment ended with guidance; partial otherwise",
          "enum": [
            "partial",
            "sufficient"
          ]
        },
        "assessment_id": {
          "type": "string",
          "description": "assessment_id from the last assess_observation response"
        }
      }
    }
  }
}
