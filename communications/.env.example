# Copia a .env y rellena. Nunca subas .env al repositorio.

# --- Mock del backend /v1 (sustituye al backend del Integrante 3 mientras no esté desplegado) ---
MOCK_BACKEND_PORT=8787
# Token de servicio que el mock exige en Authorization: Bearer <token>. Genera uno aleatorio.
MOCK_SERVICE_TOKEN=

# --- Cliente del backend (lo usan las server tools y los webhooks) ---
# Durante el desarrollo apunta al mock; luego a la URL del Integrante 3.
# Backend real: http://<host>:8000 (con o sin /v1). Aún no tiene /v1/followups: el seguimiento necesita el mock.
BACKEND_BASE_URL=http://127.0.0.1:8787
# El mock exige el mismo valor que MOCK_SERVICE_TOKEN; el backend real todavía no pide token (déjalo vacío).
BACKEND_SERVICE_TOKEN=
BACKEND_TIMEOUT_MS=8000
# Asesor del Integrante 2 (advisor/, p. ej. http://127.0.0.1:8001). Vacío = BACKEND_BASE_URL (el mock sirve ambos).
ADVISOR_BASE_URL=

# --- Twilio ---
# Sin TWILIO_ACCOUNT_SID los SMS salientes (seguimiento) usan un stub y no se envía nada.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de Twilio (no tu celular) en E.164, p. ej. +15551234567: el mismo importado en ElevenLabs.
TWILIO_PHONE_NUMBER=

# URL HTTPS pública exacta de este servicio (ngrok o deploy), sin "/" final.
# Twilio firma los webhooks con ella; si no coincide, la validación de firma falla.
PUBLIC_BASE_URL=

# --- ElevenLabs: los agentes se crean en el panel (agents/README.md); aquí solo sus IDs ---
# Con IS_DEMO=false todo este bloque es obligatorio y el servidor no arranca si un agente está mal
# configurado (compruébalo con: npm run agents:check).
# Clave con permisos de agentes y números.
ELEVENLABS_API_KEY=
# Agente de ayuda (llamadas entrantes; el número importado contesta con él).
ELEVENLABS_HELP_AGENT_ID=
# Agente de seguimiento (llamadas salientes). En demo, sin él y sin el número, las salientes usan un stub.
ELEVENLABS_FOLLOWUP_AGENT_ID=
# ID del número Twilio importado en ElevenLabs (Phone Numbers), no el número E.164.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Secreto HMAC del webhook post-call (lo genera ElevenLabs al crear el webhook).
ELEVENLABS_WEBHOOK_SECRET=

# --- Herramientas y seguimiento ---
# Secreto aleatorio (>= 16 caracteres) que ElevenLabs envía a /v1/tools/* como "Authorization: Bearer <secreto>".
ELEVENLABS_TOOL_SECRET=
# Token (>= 16 caracteres) con el que el worker del backend entrega followup.due a /v1/followups/{id}/dispatch.
COMMS_SERVICE_TOKEN=
# Sondeo de seguimientos vencidos como respaldo del evento (0 = desactivado: solo llama el evento/curl).
FOLLOWUP_POLL_INTERVAL_MS=30000
FOLLOWUP_CALL_ATTEMPTS=3
FOLLOWUP_CALL_RESULT_TIMEOUT_MS=600000
FOLLOWUP_PLACEMENT_BACKOFF_MS=120000

# --- Servidor de comunicaciones (webhooks) ---
# ngrok debe apuntar a este puerto: ngrok http 8080 --url=$PUBLIC_BASE_URL
COMMS_PORT=8080
IS_DEMO=true
DEFAULT_LANGUAGE=es
SMS_STEP_TIMEOUT_MS=4000
SMS_SESSION_IDLE_MS=1800000
# Llamada de ayuda sin actividad: se da por cortada y lo descrito (con permiso) se guarda como parcial.
VOICE_SESSION_IDLE_MS=900000
REPORT_RETRY_DELAYS_MS=5000,30000
# Ventana para responder a un seguimiento por SMS antes de registrar no_response (24 h).
FOLLOWUP_SMS_REPLY_WINDOW_MS=86400000
# Lista blanca de demo: solo estos números reciben SMS o llamadas proactivas. Vacía = nadie.
# Ejemplo: DEMO_ALLOWED_NUMBERS=+5215512345678,+5215587654321
DEMO_ALLOWED_NUMBERS=
# Solo demo: contactar fuera del horario permitido (08:00–19:00) para probar de noche.
# Consentimiento y lista blanca se siguen exigiendo. Con IS_DEMO=false el servidor no arranca.
DEMO_IGNORE_ALLOWED_HOURS=false

# --- Pruebas con teléfonos reales (solo el mock) ---
# Asocia tu propio celular a un agricultor demo para probar con SMS reales. Solo teléfonos de prueba propios.
# contact_demo_01 = Rosa (número único); contact_demo_02 = Tomás y Lucía (teléfono compartido).
# Ejemplo: MOCK_PHONE_OVERRIDES=contact_demo_01=+5215512345678
MOCK_PHONE_OVERRIDES=
