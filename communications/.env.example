# Copy to .env and fill in. Never commit .env to the repository.

# --- /v1 backend mock (stands in for Member 3's backend until it is deployed) ---
MOCK_BACKEND_PORT=8787
# Service token the mock requires in Authorization: Bearer <token>. Generate a random one.
MOCK_SERVICE_TOKEN=

# --- Backend client (used by the server tools and the webhooks) ---
# During development point it at the mock; later at Member 3's URL.
# Real backend: http://<host>:8000 (with or without /v1). It doesn't have /v1/followups yet: follow-ups need the mock.
BACKEND_BASE_URL=http://127.0.0.1:8787
# The mock requires the same value as MOCK_SERVICE_TOKEN; the real backend doesn't ask for a token yet (leave it empty).
BACKEND_SERVICE_TOKEN=
BACKEND_TIMEOUT_MS=8000
# Member 2's advisor (advisor/, e.g. http://127.0.0.1:8001). Empty = BACKEND_BASE_URL (the mock serves both).
ADVISOR_BASE_URL=

# --- Twilio ---
# Without TWILIO_ACCOUNT_SID, outbound SMS (follow-up) use a stub and nothing is sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio number (not your cell) in E.164, e.g. +15551234567: the same one imported into ElevenLabs.
TWILIO_PHONE_NUMBER=

# Exact public HTTPS URL of this service (ngrok or deploy), without a trailing "/".
# Twilio signs webhooks with it; if it doesn't match, signature validation fails.
PUBLIC_BASE_URL=

# --- ElevenLabs: agents are created in the dashboard (agents/README.md); only their IDs go here ---
# With IS_DEMO=false this whole block is required and the server won't start if an agent is
# misconfigured (check it with: npm run agents:check).
# Key with agent and phone number permissions.
ELEVENLABS_API_KEY=
# Help agent (inbound calls; the imported number answers with it).
ELEVENLABS_HELP_AGENT_ID=
# Follow-up agent (outbound calls). In demo, without it and the number, outbound calls use a stub.
ELEVENLABS_FOLLOWUP_AGENT_ID=
# ID of the Twilio number imported into ElevenLabs (Phone Numbers), not the E.164 number.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# HMAC secret for the post-call webhook (ElevenLabs generates it when you create the webhook).
ELEVENLABS_WEBHOOK_SECRET=

# --- Tools and follow-ups ---
# Random secret (>= 16 characters) ElevenLabs sends to /v1/tools/* as "Authorization: Bearer <secret>".
ELEVENLABS_TOOL_SECRET=
# Token (>= 16 characters) the backend worker uses to deliver followup.due to /v1/followups/{id}/dispatch.
COMMS_SERVICE_TOKEN=
# Polling for due follow-ups as a fallback for the event (0 = off: only the event/curl places calls).
FOLLOWUP_POLL_INTERVAL_MS=30000
FOLLOWUP_CALL_ATTEMPTS=3
FOLLOWUP_CALL_RESULT_TIMEOUT_MS=600000
FOLLOWUP_PLACEMENT_BACKOFF_MS=120000

# --- Communications server (webhooks) ---
# ngrok must point at this port: ngrok http 8080 --url=$PUBLIC_BASE_URL
COMMS_PORT=8080
IS_DEMO=true
DEFAULT_LANGUAGE=en
SMS_STEP_TIMEOUT_MS=4000
SMS_SESSION_IDLE_MS=1800000
# Help call with no activity: considered dropped, and what was described (with permission) is saved as partial.
VOICE_SESSION_IDLE_MS=900000
REPORT_RETRY_DELAYS_MS=5000,30000
# Window to reply to an SMS follow-up before no_response is recorded (24 h).
FOLLOWUP_SMS_REPLY_WINDOW_MS=86400000
# Demo allowlist: only these numbers get proactive SMS or calls. Empty = nobody.
# Example: DEMO_ALLOWED_NUMBERS=+5215512345678,+5215587654321
DEMO_ALLOWED_NUMBERS=
# Demo only: contact outside allowed hours (08:00–19:00) to test at night.
# Consent and the allowlist are still enforced. With IS_DEMO=false the server won't start.
DEMO_IGNORE_ALLOWED_HOURS=false

# --- Testing with real phones (mock only) ---
# Maps your own cell to a demo farmer to test with real SMS. Only your own test phones.
# contact_demo_01 = Rosa (single owner); contact_demo_02 = Tomás and Lucía (shared phone).
# Example: MOCK_PHONE_OVERRIDES=contact_demo_01=+5215512345678
MOCK_PHONE_OVERRIDES=
