# Asesor (proceso del backend). Copiar a .env y rellenar.
# Nunca commitear .env ni exponer OPENAI_API_KEY al navegador.

OPENAI_API_KEY=
ADVISOR_MODE=openai
ADVISOR_BACKEND_BASE_URL=http://localhost:8000

