{
  "$defs": {
    "Channel": {
      "enum": [
        "voice",
        "sms",
        "operator"
      ],
      "title": "Channel",
      "type": "string"
    },
    "Completeness": {
      "enum": [
        "partial",
        "sufficient"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "sample_type": {
          "$ref": "#/$defs/SampleType"
        },
        "measured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured At"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "source": {
          "$ref": "#/$defs/MeasurementSource",
          "default": "farmer_reported"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "sample_type"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "MeasurementSource": {
      "enum": [
        "farmer_reported",
        "sensor",
        "technician"
      ],
      "title": "MeasurementSource",
      "type": "string"
    },
    "SampleType": {
      "enum": [
        "soil",
        "irrigation_water",
        "leaf",
        "other"
      ],
      "title": "SampleType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "plot_id": {
      "title": "Plot Id",
      "type": "string"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    },
    "channel": {
      "$ref": "#/$defs/Channel"
    },
    "provider_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Reference"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At"
    },
    "symptoms": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Symptoms",
      "type": "array"
    },
    "measurements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Measurement"
      },
      "title": "Measurements",
      "type": "array"
    },
    "user_statement": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User Statement"
    },
    "completeness": {
      "$ref": "#/$defs/Completeness"
    },
    "assessment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assessment Id"
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "session_id",
    "plot_id",
    "channel",
    "completeness",
    "is_demo"
  ],
  "title": "ReportCreate",
  "type": "object"
}
