{
  "$defs": {
    "NotificationStatus": {
      "enum": [
        "queued",
        "sending",
        "accepted",
        "delivered",
        "failed",
        "unknown",
        "cancelled"
      ],
      "title": "NotificationStatus",
      "type": "string"
    }
  },
  "description": "`applied: false` = the notification was already terminal; nothing changed.",
