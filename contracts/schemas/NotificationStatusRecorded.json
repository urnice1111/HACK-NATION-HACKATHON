    },
    "attempt_count": {
      "title": "Attempt Count",
      "type": "integer"
    },
    "provider_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Reference"
    },
    "applied": {
      "title": "Applied",
      "type": "boolean"
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "notification_id",
    "status",
    "attempt_count",
    "provider_reference",
    "applied",
    "is_demo"
  ],
  "title": "NotificationStatusRecorded",
  "type": "object"
}
