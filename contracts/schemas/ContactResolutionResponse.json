{
  "$defs": {
    "ConfirmedFarmer": {
      "properties": {
        "farmer_id": {
          "title": "Farmer Id",
          "type": "string"
        },
        "preferred_language": {
          "title": "Preferred Language",
          "type": "string"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        },
        "consent": {
          "$ref": "#/$defs/ContactConsent"
        },
        "plots": {
          "items": {
            "$ref": "#/$defs/ConfirmedPlot"
          },
          "title": "Plots",
          "type": "array"
        }
      },
      "required": [
        "farmer_id",
        "preferred_language",
        "timezone",
        "consent",
        "plots"
      ],
      "title": "ConfirmedFarmer",
      "type": "object"
    },
    "ConfirmedPlot": {
      "properties": {
        "plot_id": {
          "title": "Plot Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "plot_id",
        "label"
      ],
      "title": "ConfirmedPlot",
      "type": "object"
    },
    "ContactCandidate": {
      "description": "Minimal label to ask \"¿hablo con…?\"; nothing else from the record.",
      "properties": {
        "candidate_token": {
          "title": "Candidate Token",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "candidate_token",
        "label"
      ],
      "title": "ContactCandidate",
      "type": "object"
    },
    "ContactConsent": {
      "description": "null = never asked; false = denied or revoked.",
      "properties": {
        "reports": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reports"
        },
        "notifications": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notifications"
        },
        "followup_calls": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Followup Calls"
        },
        "consent_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Consent At"
        }
      },
      "required": [
        "reports",
        "notifications",
        "followup_calls",
        "consent_at"
      ],
      "title": "ContactConsent",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "resolution_status": {
      "enum": [
        "no_match",
        "candidates",
        "confirmed"
      ],
      "title": "Resolution Status",
      "type": "string"
    },
    "requires_confirmation": {
      "title": "Requires Confirmation",
      "type": "boolean"
    },
    "is_shared_phone": {
      "title": "Is Shared Phone",
      "type": "boolean"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ContactCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "confirmed": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfirmedFarmer"
        },
        {
          "type": "null"
        }
      ]
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "session_id",
    "resolution_status",
    "requires_confirmation",
    "is_shared_phone",
    "candidates",
    "confirmed",
    "is_demo"
  ],
  "title": "ContactResolutionResponse",
  "type": "object"
}
