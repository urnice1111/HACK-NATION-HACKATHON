{
  "additionalProperties": false,
  "description": "\"BAJA\" by SMS revokes for every contact with that phone.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "phone_e164": {
      "pattern": "^\\+[1-9][0-9]{1,14}$",
      "title": "Phone E164",
      "type": "string"
    },
    "channel": {
      "const": "sms",
      "default": "sms",
      "title": "Channel",
      "type": "string"
    },
    "scopes": {
      "items": {
        "enum": [
          "notifications",
          "followup_calls"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Scopes",
      "type": "array"
    },
    "provider_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Reference"
    },
    "is_demo": {
      "default": true,
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "phone_e164",
    "scopes"
  ],
  "title": "ConsentRevocationRequest",
  "type": "object"
}
