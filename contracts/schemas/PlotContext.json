{
  "$defs": {
    "ActiveCase": {
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "threat_code": {
          "title": "Threat Code",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "last_observation_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Observation At"
        }
      },
      "required": [
        "case_id",
        "threat_code",
        "status",
        "opened_at",
        "last_observation_at"
      ],
      "title": "ActiveCase",
      "type": "object"
    },
    "DataFreshness": {
      "enum": [
        "fresh",
        "stale",
        "unknown"
      ],
      "title": "DataFreshness",
      "type": "string"
    },
    "EnvFeature": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "EnvFeature",
      "type": "object"
    },
    "EnvironmentSummary": {
      "properties": {
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        },
        "data_freshness": {
          "$ref": "#/$defs/DataFreshness"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/EnvFeature"
          },
          "title": "Features",
          "type": "array"
        },
        "dataset_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dataset Ids",
          "type": "array"
        }
      },
      "required": [
        "computed_at",
        "data_freshness",
        "features"
      ],
      "title": "EnvironmentSummary",
      "type": "object"
    },
    "PendingFollowup": {
      "properties": {
        "followup_id": {
          "title": "Followup Id",
          "type": "string"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "followup_id",
        "case_id",
        "due_at",
        "status"
      ],
      "title": "PendingFollowup",
      "type": "object"
    }
  },
  "description": "No coordinates or contact data: this goes to the voice agent.",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "plot_id": {
      "title": "Plot Id",
      "type": "string"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "crop": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Crop"
    },
    "variety": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Variety"
    },
    "altitude_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Altitude M"
    },
    "data_freshness": {
      "$ref": "#/$defs/DataFreshness"
    },
    "environment_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_cases": {
      "items": {
        "$ref": "#/$defs/ActiveCase"
      },
      "title": "Active Cases",
      "type": "array"
    },
    "pending_followups": {
      "items": {
        "$ref": "#/$defs/PendingFollowup"
      },
      "title": "Pending Followups",
      "type": "array"
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "plot_id",
    "label",
    "crop",
    "variety",
    "altitude_m",
    "data_freshness",
    "environment_summary",
    "active_cases",
    "pending_followups",
    "is_demo"
  ],
  "title": "PlotContext",
  "type": "object"
}
