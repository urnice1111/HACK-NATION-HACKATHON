{
  "$defs": {
    "Channel": {
      "enum": [
        "voice",
        "sms",
        "operator"
      ],
      "title": "Channel",
      "type": "string"
    },
    "Completeness": {
      "enum": [
        "partial",
        "sufficient"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "MeasurementSource": {
      "enum": [
        "farmer_reported",
        "sensor",
        "technician"
      ],
      "title": "MeasurementSource",
      "type": "string"
    },
    "ProcessingStatus": {
      "enum": [
        "pending",
        "processed",
        "failed"
      ],
      "title": "ProcessingStatus",
      "type": "string"
    },
    "ReportMeasurement": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "sample_type": {
          "title": "Sample Type",
          "type": "string"
        },
        "measured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Measured At"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Method"
        },
        "source": {
          "$ref": "#/$defs/MeasurementSource"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "sample_type",
        "measured_at",
        "method",
        "source"
      ],
      "title": "ReportMeasurement",
      "type": "object"
    }
  },
  "properties": {
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Case Id"
    },
    "plot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Plot Id"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "channel": {
      "$ref": "#/$defs/Channel"
    },
    "provider_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Reference"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed At"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "symptoms": {
      "items": {
        "type": "string"
      },
      "title": "Symptoms",
      "type": "array"
    },
    "measurements": {
      "items": {
        "$ref": "#/$defs/ReportMeasurement"
      },
      "title": "Measurements",
      "type": "array"
    },
    "user_statement": {
      "title": "User Statement",
      "type": "string"
    },
    "completeness": {
      "$ref": "#/$defs/Completeness"
    },
    "assessment_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Assessment Id"
    },
    "processing_status": {
      "$ref": "#/$defs/ProcessingStatus"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "report_id",
    "case_id",
    "plot_id",
    "session_id",
    "channel",
    "provider_reference",
    "observed_at",
    "received_at",
    "symptoms",
    "measurements",
    "user_statement",
    "completeness",
    "assessment_id",
    "processing_status",
    "created_at",
    "is_demo"
  ],
  "title": "ReportDetail",
  "type": "object"
}
