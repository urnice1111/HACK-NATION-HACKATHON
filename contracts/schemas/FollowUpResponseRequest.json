{
  "$defs": {
    "ActionWorked": {
      "enum": [
        "yes",
        "no",
        "partial",
        "unknown"
      ],
      "title": "ActionWorked",
      "type": "string"
    },
    "StatusReported": {
      "enum": [
        "worse",
        "same",
        "improved",
        "resolved",
        "unknown"
      ],
      "title": "StatusReported",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "channel": {
      "enum": [
        "voice",
        "sms"
      ],
      "title": "Channel",
      "type": "string"
    },
    "status_reported": {
      "$ref": "#/$defs/StatusReported"
    },
    "user_statement": {
      "title": "User Statement",
      "type": "string"
    },
    "actions_taken": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actions Taken"
    },
    "action_worked": {
      "$ref": "#/$defs/ActionWorked",
      "default": "unknown"
    },
    "change_noticed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Change Noticed At"
    },
    "provider_reference": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Reference"
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "session_id",
    "channel",
    "status_reported",
    "user_statement",
    "is_demo"
  ],
  "title": "FollowUpResponseRequest",
  "type": "object"
}
