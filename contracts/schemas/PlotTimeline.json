{
  "$defs": {
    "PlotTimelineEvent": {
      "description": "One thing that happened on the plot. No phone or farmer name.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "enum": [
            "report.created",
            "risk.updated",
            "followup.due",
            "followup.responded",
            "case.resolved"
          ],
          "title": "Event Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "threat_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Threat Code"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Case Id"
        },
        "report_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Report Id"
        },
        "followup_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Followup Id"
        },
        "resolution_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolution Id"
        },
        "is_demo": {
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "occurred_at",
        "summary",
        "threat_code",
        "case_id",
        "report_id",
        "followup_id",
        "resolution_id",
        "is_demo"
      ],
      "title": "PlotTimelineEvent",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "plot_id": {
      "title": "Plot Id",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/PlotTimelineEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "is_demo": {
      "title": "Is Demo",
      "type": "boolean"
    }
  },
  "required": [
    "plot_id",
    "events",
    "is_demo"
  ],
  "title": "PlotTimeline",
  "type": "object"
}
